{
  "$comment": "Source of truth for the portrait media library. scripts/media/build-photos.mjs reads this and writes responsive WebP crops to public/assets/media/photos/<id>-<crop>-<width>.webp. Focus points are fractions (0-1) of the upright source image. `zoom` > 1 crops tighter than the largest rectangle of that aspect ratio that fits. `place` drives the region rules (singapore | hong-kong | event | neutral): pages about Korea, India, Japan, MENA and other places only use `event` and `neutral` photos. `frame` pulls a still from a video. Locations in `place` and `alt` come from what is visible in each photo (signage, badges, skyline); correct them here and re-run the build if a caption is wrong.",
  "basePath": "/assets/media/photos",
  "crops": {
    "wide": {
      "ratio": 2.4,
      "widths": [
        800,
        1440,
        2000
      ],
      "use": "hero and section bands (desktop)"
    },
    "land": {
      "ratio": 1.6,
      "widths": [
        640,
        1100
      ],
      "use": "in-content figures"
    },
    "sq": {
      "ratio": 1,
      "widths": [
        320,
        640
      ],
      "use": "avatars, cards, thumbnails"
    },
    "port": {
      "ratio": 0.8,
      "widths": [
        480,
        800,
        1080
      ],
      "use": "portrait cards, mobile bands, CTA banners"
    }
  },
